{
  "name": "webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "check:worker": "npm run cf:types && tsc -p tsconfig.worker.json",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test": "vitest run cloudflare/*.test.ts",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:migrate:local": "wrangler d1 migrations apply zacks-tennis-alerts --local"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
