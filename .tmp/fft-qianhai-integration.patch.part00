diff --git a/dags/tennis_dags/sz_tennis/fft_qianhai_watcher.py b/dags/tennis_dags/sz_tennis/fft_qianhai_watcher.py
new file mode 100644
index 0000000000000000000000000000000000000000..545138b358fa63a3388e4f4361958ac3914de59f
--- /dev/null
+++ b/dags/tennis_dags/sz_tennis/fft_qianhai_watcher.py
@@ -0,0 +1,33 @@
+import datetime
+from datetime import timedelta
+from zoneinfo import ZoneInfo
+
+from airflow.providers.standard.operators.python import PythonOperator
+from airflow.sdk import DAG
+
+from wechat_airflow.venues.fft_qianhai_watcher import run_check_tennis_courts
+
+DEFAULT_ARGS = {
+    "owner": "claude89757",
+    "depends_on_past": False,
+    "start_date": datetime.datetime(2026, 8, 30, tzinfo=ZoneInfo("Asia/Shanghai")),
+    "email_on_failure": False,
+    "email_on_retry": False,
+}
+
+dag = DAG(
+    "FFTENNIS前海国际网球中心巡检",
+    default_args=DEFAULT_ARGS,
+    description="FFTENNIS前海国际网球中心巡检 - PosPal平台",
+    schedule=timedelta(seconds=30),
+    max_active_runs=1,
+    dagrun_timeout=timedelta(minutes=10),
+    catchup=False,
+    tags=["深圳"],
+)
+
+PythonOperator(
+    task_id="check_tennis_courts",
+    python_callable=run_check_tennis_courts,
+    dag=dag,
+)
diff --git a/docs/integrations/fft-qianhai-pospal.md b/docs/integrations/fft-qianhai-pospal.md
new file mode 100644
index 0000000000000000000000000000000000000000..76bde1af4f66b19d9aa595d322dc03a4a4506ed8
--- /dev/null
+++ b/docs/integrations/fft-qianhai-pospal.md
@@ -0,0 +1,37 @@
+# FFTENNIS前海国际网球中心 PosPal 场地查询接入
+
+## 来源与边界
+
+归档 `miniprogram-wxb8ec04a1ebd1866b-2026.07.25.zip` 对应的小程序使用
+PosPal / 银豹预约接口。接入仅复用无需登录、无需支付、不会创建订单的只读查询；
+登录、会员、支付和下单接口均不进入 Airflow 或 Web。归档中的任何凭据均不得写入
+代码、日志、文档或 GitHub Actions 产物。
+
+## 只读查询链路
+
+1. `Store/GetStoreDataFast`：确认门店身份与营业状态。
+2. `AppointmentVenue/LoadClassroomProjectList`：发现门店预约项目。
+3. `AppointmentVenue/AppointmentVenueConfig`：读取预约开放天数等配置。
+4. `AppointmentVenue/LoadValidClassRoomApptSettingV2`：按日期查询场地时段。
+
+运行时使用公开门店标识 `5934657`、项目标识 `1756717886546691955`，以及
+`dateTime`、`projectUid`、`userId` 三个查询字段。适配器先直连，失败后才使用现有
+公开 HTTPS 代理池；该策略仅对 `fft_qianhai` 生效。
+
+## 2026-08-30 只读验证
+
+隔离 GitHub Actions 运行器连续查询 2026-08-30、2026-08-31 和 2026-09-01：
+
+- 门店名称精确返回 `FFTENNIS前海国际网球中心`，状态正常且未停业。
+- 项目列表返回一个 `网球场` 项目。
+- 三天查询均返回 `success`，每天 159 个时段、10 个场地。
+- 可订时段数分别为 103、123、130。
+
+这些数字只证明接口和响应结构在验证时可用，不作为长期场地余量承诺。
+
+## 场地筛选与通知安全
+
+Web 和微信只接收 1–6 号标准双打场。名称包含 `非标`、`发球机`、`小场`、
+`匹克` 或 `练习` 的场地在解析阶段即被剔除。首次完整成功巡检先发布 Web 原始
+观测并写入通知去重缓存，再记录初始化标记；该轮不发送微信，避免上线时把当前
+全部余量当作新增消息。之后仅通知新出现且符合现有时段、时长规则的可订区间。
